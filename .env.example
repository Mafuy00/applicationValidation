# Copy this file to `.env` in the same folder and fill in the real values.
# `.env` is gitignored and must never be committed.

# --- Credentials: PREFER Windows Credential Manager, not this file ----------
# This repo lives inside a synced OneDrive folder, so a password typed into a
# .env here gets copied to the cloud. Store it encrypted against your Windows
# account instead - it only has to be done once:
#
#     cd upload_application_automation
#     python set_credentials.py
#
# The two variables below are only a fallback (for a machine without a
# credential store, or a CI runner that injects its own secrets). If they are
# set, they take precedence over Credential Manager - so leave them blank
# unless you mean to use them.
SIP_INTRANET_USERNAME=
SIP_INTRANET_PASSWORD=

# --- Optional: overrides for upload_application_automation -----------------
# Defaults are shown; uncomment only what you need to change.

# SIP batch that uploads are filed under. Must match one of the portal
# dropdown's options exactly - the portal writes the academic year twice, e.g.
# "AY2627-AY2627" for AY26/27. Change this each academic year.
# SIP_UPLOAD_BATCH=AY2627-AY2627

# Where verified application forms are downloaded to.
# Defaults to <Documents>\Applications (OneDrive-aware).
# SIP_UPLOAD_DOWNLOAD_DIR=

# Portal log-on page.
# SIP_INTRANET_LOGON_URL=https://intranetapps.tp.edu.sg/sip/Account/LogOn

# Run the browser without a visible window (1 = headless).
# SIP_UPLOAD_HEADLESS=0

# Which browser to drive. Empty tries Chrome, then Edge, then Playwright's
# bundled Chromium. Set to 'chrome' or 'msedge' to pin one.
# SIP_UPLOAD_BROWSER_CHANNEL=

# Apply Playwright Stealth to mask automation fingerprints (1 = on).
# SIP_UPLOAD_STEALTH=1

# Slow every browser action down by N ms - handy when tuning selectors.
# SIP_UPLOAD_SLOW_MO_MS=0

# Per-action / per-navigation timeout, in ms.
# SIP_UPLOAD_TIMEOUT_MS=30000

# Seconds to wait after submitting before deciding the upload's outcome.
# SIP_UPLOAD_WAIT_SECONDS=8

# Treat "no success banner shown" as a failure (1) instead of a pass (0).
# Turn this on once result.success in selectors.json matches the portal's
# real confirmation message.
# SIP_UPLOAD_REQUIRE_SUCCESS_CONFIRMATION=0
